<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Screen Bubble Translate"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvModelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Status model: Memeriksa..." />

    <Button
        android:id="@+id/btnDownloadModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="1. Unduh Model Translate (JP -&gt; ID)" />

    <Button
        android:id="@+id/btnStartBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2. Aktifkan Bubble Melayang" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Bubble melayang akan muncul di atas layar. Langkah berikutnya kita tambah tangkap layar &amp; OCR."
        android:textSize="13sp" />

</LinearLayout>
